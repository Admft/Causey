# ---------------------------------------------------------------------------
# Causey app environment. Every value is optional: the app boots with an
# empty .env and runs entirely on seeded mock data (DATA_SOURCE defaults to
# "mock" and no network calls are made).
# ---------------------------------------------------------------------------

# 'mock' (default) reads /data/seed JSON in-process.
# 'supabase' runs against a Supabase project via lib/data/supabase.ts.
DATA_SOURCE=mock

# Required only when DATA_SOURCE=supabase (and for accounts / auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used by `npm run seed:supabase`, scrapers, and purge.
# Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Auth (Supabase Auth — Email provider).
# 1. Enable Email under Authentication → Sign In / Providers
# 2. URL Configuration:
#      Site URL: http://localhost:3000  (prod: https://app.causey.dev)
#      Redirect URLs: http://localhost:3000/auth/callback
#                     https://app.causey.dev/auth/callback
# 3. Custom SMTP (required for real signup / password-reset volume).
#    Built-in Supabase mail is capped at ~2 emails/hour and is not for
#    production. Enable custom SMTP so Auth can send through your provider:
#      Dashboard → Authentication → SMTP
#        https://supabase.com/dashboard/project/_/auth/smtp
#    Recommended provider: Resend (smtp.resend.com).
#      1. Create a Resend account and verify your sending domain (SPF/DKIM).
#      2. Create an API key.
#      3. In Supabase SMTP settings:
#           Host: smtp.resend.com
#           Port: 465  (or 587)
#           Username: resend
#           Password: <Resend API key>
#           Sender email: e.g. auth@yourdomain.com  (must be on the verified domain)
#           Sender name: Causey
#      4. After enabling SMTP, raise the Auth email rate limit:
#           Authentication → Rate Limits
#           https://supabase.com/dashboard/project/_/auth/rate-limits
#         Default after custom SMTP is ~30/hour; set higher to match your
#         Resend plan if you need more (signup + resets share this bucket).
#    Docs: https://supabase.com/docs/guides/auth/auth-smtp
# 4. Apply migrations 0009–0014 (accounts, orgs, org access, groups/RSVP,
#    org attendance, recommendations/insights):
#    Preferred: `supabase link` then `supabase db push` (tracks history in schema_migrations).
#    Manual SQL editor works but skips tracking — if you later use the CLI, run:
#      supabase migration repair --status applied 0009   (repeat for 0010–0014)
#    NOTE: 0011 also fixes broken recursive RLS policies from 0010 — apply it
#    even if you don't use the portals yet.
# Then open /signup — student, coach/organizer, and parent accounts all work:
# coaches create orgs (/orgs) with join codes and host tournaments; students
# join with a code and RSVP; parents link to children (/family).

# Optional: Resend API key if the app itself sends product email later
# (coach announcements, invites). Auth emails use Supabase SMTP above —
# this env var is NOT required for signup/reset once SMTP is configured.
# RESEND_API_KEY=

# Before a full scrape, apply migrations 0005–0008 (or PENDING_SCRAPE.sql)
# in the Supabase SQL editor, then:
#   npm run scrape:preflight
#   npm run scrape:all

# ---------------------------------------------------------------------------
# Pathway enrichment (OpenAI gpt-4.1-mini via AI SDK)
# Runs after each scrape and via `npm run enrich:pathways`.
# Cost controls: heuristic triage + hash cache + batched calls (see ingestion/).
# ---------------------------------------------------------------------------
# Put your OpenAI key here (https://platform.openai.com/api-keys).
# Same variable in GitHub Actions secrets for scheduled scrapes.
OPENAI_API_KEY=

# Default model — cheap classifier. Override only if you need more accuracy.
# ENRICH_MODEL=gpt-4.1-mini

# Set to 0 to skip enrichment during scrapes.
# ENRICH_PATHWAYS=1

# Cap how many "suspect" events hit the model per run (rest stay heuristic).
# ENRICH_MAX_AI=80
# ENRICH_BATCH_SIZE=20

# Also send ambiguous names (not just scholastic/champ keywords) to the model.
# ENRICH_AMBIGUOUS=0

# Limit enrich CLI to one source: tla_scrape | cca_scrape
# ENRICH_SOURCE=
