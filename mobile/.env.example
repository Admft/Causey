# Android emulator talking to Next.js on the host:
# EXPO_PUBLIC_CAUSEY_API_URL=http://10.0.2.2:3000
# iOS simulator:
# EXPO_PUBLIC_CAUSEY_API_URL=http://localhost:3000
# Physical phone on the same Wi-Fi (use the Mac/PC LAN IP; restart Expo after):
# EXPO_PUBLIC_CAUSEY_API_URL=http://192.168.1.10:3000
