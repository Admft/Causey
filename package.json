    "seed:generate": "node scripts/generate-seed.mjs",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "seed:zips": "tsx scripts/load-zips.ts",
    "scrape:tla": "tsx ingestion/scrape-tla.ts",
    "scrape:cca": "tsx ingestion/scrape-cca.ts",
    "scrape:fide": "tsx ingestion/scrape-fide.ts",
    "scrape:tca": "tsx ingestion/scrape-tca.ts",
    "scrape:chess-results": "tsx ingestion/scrape-chess-results.ts",
    "scrape:onlinereg": "tsx ingestion/scrape-onlinereg.ts",
    "scrape:all": "tsx ingestion/scrape-all.ts",
    "enrich:pathways": "tsx ingestion/enrich-pathways-cli.ts",
